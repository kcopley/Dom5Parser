{
  "about": "How the event page reads each event command (docs/EVENT_EDITOR.md, E-2): its group, a sentence ({v}: the value as words; text1/text0 for 0-1 commands), and its argument kind (for the value's editor and its words). From the event manual (docs/pdf_extracted/eventman.txt); hover hints come from command_hints.json.",
  "argKinds": {
    "number": "a number",
    "percent": "a percent",
    "bool": "1 = yes, 0 = no (the sentence says which)",
    "nation": "a nation (number); events also take -1 random enemy, -2 province owner",
    "monster": "a monster (name or number; negative: a monster tag)",
    "site": "a site (number; -1: the site named in brackets in the message)",
    "item": "a magic item (name or number)",
    "code": "a province event code (mods: -300 to -5000; 0 resets)",
    "var": "an event variable (0-9999; -1 nation, -2 player, -3/-4 province)",
    "ench": "an enchantment number (a spell's #damage)",
    "path": "a magic path (0-9)",
    "targpath": "a magic path (0-9, 50 random, 51 elemental, 52 sorcery, 53 all)",
    "gem": "a gem type (0-8; 53 all, 56 all but blood)",
    "scale": "a scale (0-5)",
    "school": "a research school (0-7)",
    "season": "a season (0-3)",
    "month": "a month (0-11)",
    "era": "an era (1-3)",
    "order": "a commander's order",
    "ordermask": "province orders to offer (sum of masks)",
    "affmask": "afflictions (sum of powers of 2)",
    "terrainmask": "terrain (sum of masks)",
    "rarity": "how the event is rolled",
    "header": "the message header",
    "poptype": "a population type",
    "fort": "a fort type",
    "plane": "a plane (0 default, -1 caves, -2 nexus)",
    "attr": "1 the next, 0 this, -1 the previous event",
    "none": "no value"
  },
