<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dom5Editor.Ava.Views.ModInfoView">
    <!-- The mod's header (UI.Views.ModInfoViewModel): #modname, #description, #version, #domversion, #icon;
         the mods it needs. (Boxes save when left: each change is an edit, one undo step.) -->
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Mod Info" Classes="header"/>
            <StackPanel Spacing="2">
                <TextBlock Text="NAME (#modname)" Classes="label"/>
                <TextBox Text="{Binding ModName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="The mod's name in the game's mod list"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="DESCRIPTION (#description)" Classes="label"/>
                <TextBox Text="{Binding ModDescription, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="220"
                         ToolTip.Tip="What the game's mod list says about the mod"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,12,*">
                <StackPanel Spacing="2">
                    <TextBlock Text="VERSION (#version)" Classes="label"/>
                    <TextBox Text="{Binding ModVersion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="The mod's own version"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="GAME VERSION (#domversion)" Classes="label"/>
                    <TextBox Text="{Binding ModDomVersion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="The lowest Dominions version the mod works with"/>
                </StackPanel>
            </Grid>
            <!-- the mods this one needs (a submod's parent): read first, never changed or saved -->
            <StackPanel Spacing="4">
                <TextBlock Text="NEEDS (mods the game reads before this one)" Classes="label"/>
                <ItemsControl ItemsSource="{Binding Needed}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,4" ToolTip.Tip="{Binding File}">
                                <Button DockPanel.Dock="Right" Content="Remove" Classes="small" Margin="6,0,0,0" Command="{Binding RemoveCommand}"
                                        ToolTip.Tip="Read this mod without it (it is read again)"/>
                                <Button DockPanel.Dock="Right" Content="▲" Classes="small" Margin="6,0,0,0" Command="{Binding MoveUpCommand}"
                                        ToolTip.Tip="Read it before the one above (the game reads mods in the order they were enabled)"/>
                                <TextBlock Text="{Binding Order}" Classes="muted" Width="20" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FileName, StringFormat='  {0}'}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add a mod it needs..." Classes="small" HorizontalAlignment="Left"
                        Command="{Binding AddNeededCommand}" IsEnabled="{Binding CanChangeNeeded}" ToolTip.Tip="{Binding NeededTip}" ToolTip.ShowOnDisabled="True"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Mods the game must read before this one (a submod's parent): enable them first, in this order. Their entities are shown and can be changed by this mod, as vanilla's; they are never changed or saved."/>
            </StackPanel>
            <StackPanel Spacing="2">
                <TextBlock Text="BANNER (#icon)" Classes="label"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Pick..." Margin="6,0,0,0" Command="{Binding PickIconCommand}"
                            ToolTip.Tip="Pick a banner image (128x32 or 256x64): copied into the mod's folder"/>
                    <TextBox Text="{Binding ModIcon, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="The banner image's path, relative to the mod's file"/>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
