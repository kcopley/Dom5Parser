<!-- The event page's parts (UI.ViewModels.EventPage: the script, requirements, effects, the chain
     map, ...), each a DataTemplate keyed "Panel.TypeName", as the WPF editor's EventTemplates.xaml. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Dom5Editor.UI.ViewModels;assembly=Dom5Editor.Core"
                    xmlns:local="clr-namespace:Dom5Editor.Ava"
                    xmlns:controls="clr-namespace:Dom5Editor.Ava.Controls">
</ResourceDictionary>
