<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dom5Editor.Ava.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <!-- Fluent's accent (accent buttons, check boxes, the selected tab's line) in the editor's
             brown, as the Windows editor has it (Theme/Colors.axaml AccentPrimaryColor) -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#8b4513"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Dom5Editor/Theme/Styles.axaml"/>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Dom5Editor/Theme/Colors.axaml"/>
                <ResourceInclude Source="avares://Dom5Editor/Theme/Controls.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
