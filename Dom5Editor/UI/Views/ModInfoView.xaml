<UserControl x:Class="Dom5Editor.UI.Views.ModInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             Background="{DynamicResource BackgroundMediumBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mod Information" Style="{DynamicResource HeaderText}" FontSize="20" Foreground="{DynamicResource AccentHighlightBrush}"/>
                    <TextBlock Text="Configure your mod's metadata and display settings" Style="{DynamicResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Mod Name -->
            <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Mod Name:" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding ModName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="#modname: the name in the game&apos;s mod list. Leave the box to save it."
                             Style="{DynamicResource TextBoxBase}" FontSize="12"/>

                    <TextBlock Grid.Column="1" Grid.Row="1" Text="A short name displayed in the mod preferences screen."
                               Style="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Description -->
            <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Description:" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Top" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding ModDescription, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="#description: shown in the game&apos;s mod list. Leave the box to save it."
                             Style="{DynamicResource TextBoxBase}" FontSize="12"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="200"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Grid.Column="1" Grid.Row="1" Text="A description of what the mod does, who created it, etc."
                               Style="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Version -->
            <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Version:" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding ModVersion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="#version: your mod&apos;s version number"
                             Style="{DynamicResource TextBoxBase}" FontSize="12" Width="100" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Column="1" Grid.Row="1" Text="The version number of your mod (e.g., 1.00 or 1.10)."
                               Style="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Dom Version -->
            <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Dom Version:" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding ModDomVersion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="#domversion: the lowest Dominions version the mod needs (the game won&apos;t load it on older versions)"
                             Style="{DynamicResource TextBoxBase}" FontSize="12" Width="100" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Column="1" Grid.Row="1" Text="Minimum required version of Dominions (e.g., 6.00). Leave empty if unsure."
                               Style="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- The mods this one needs (a submod's parent): read first, never changed or saved -->
            <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Needs:" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Top" Margin="0,4,8,0"/>
                    <ItemsControl Grid.Column="1" Grid.Row="0" ItemsSource="{Binding Needed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4" ToolTip="{Binding File}">
                                    <Button DockPanel.Dock="Right" Content="Remove" Style="{DynamicResource ButtonSmall}" Margin="6,0,0,0" Command="{Binding RemoveCommand}"
                                            ToolTip="Read this mod without it (it is read again)"/>
                                    <Button DockPanel.Dock="Right" Content="▲" Style="{DynamicResource ButtonSmall}" Margin="6,0,0,0" Command="{Binding MoveUpCommand}"
                                            ToolTip="Read it before the one above (the game reads mods in the order they were enabled)"/>
                                    <TextBlock Text="{Binding Order}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Width="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FileName, StringFormat='  {0}'}" Style="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="1" Grid.Row="1" Content="Add a mod it needs..." Style="{DynamicResource ButtonSmall}" HorizontalAlignment="Left" Margin="0,2,0,0"
                            Command="{Binding AddNeededCommand}" IsEnabled="{Binding CanChangeNeeded}" ToolTip="{Binding NeededTip}" ToolTipService.ShowOnDisabled="True"/>

                    <TextBlock Grid.Column="1" Grid.Row="2" Style="{DynamicResource MutedText}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Mods the game must read before this one (a submod's parent): enable them first, in this order. Their entities are shown and can be changed by this mod, as vanilla's; they are never changed or saved."/>
                </Grid>
            </Border>

            <!-- Icon -->
            <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Icon:" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DockPanel Grid.Column="1" Grid.Row="0">
                        <Button DockPanel.Dock="Right" Content="Pick..." Style="{DynamicResource ButtonSmall}" Margin="6,0,0,0" Command="{Binding PickIconCommand}"
                                ToolTip="Pick the banner image: it's copied into the mod's sprites folder and #icon set to it"/>
                        <TextBox Text="{Binding ModIcon, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="#icon: path of the banner image, relative to the .dm file (a 128x32 or 256x64 .tga)"
                                 Style="{DynamicResource TextBoxBase}" FontSize="12"/>
                    </DockPanel>

                    <TextBlock Grid.Column="1" Grid.Row="1" Text="A banner image for your mod (128x32 or 256x64 TGA file)."
                               Style="{DynamicResource MutedText}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
