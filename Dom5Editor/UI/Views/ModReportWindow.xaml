<Window x:Class="Dom5Editor.UI.Views.ModReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report"
        Height="700" Width="900"
        MinHeight="300" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{DynamicResource AppWindowStyle}"
        KeyDown="Window_KeyDown">
    <!-- What the editor found in the mod, as the author report has it (Dom5Edit.Validation.ModReport):
         sections worst first, alike findings grouped, each line with Go to. Not modal: work through it. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource HeaderText}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding About}" Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BackgroundLightBrush}" CornerRadius="4" Padding="10,4" Margin="0,0,8,4"
                                ToolTip="{Binding Intro}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Style="{DynamicResource TextBlockBase}">
                                    <Run Text="{Binding Count, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="wrong">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="ignored">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="missing">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Nothing found: the game reads the mod as written, and nothing looks off."
                           Style="{DynamicResource SubHeaderText}" Margin="0,12"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding Shown}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{DynamicResource SubHeaderText}">
                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                    <Run Text="{Binding Count, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource TextMutedBrush}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Intro}" Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Style="{DynamicResource ExpanderBase}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,4">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Text}" Style="{DynamicResource TextBlockBase}" TextWrapping="Wrap"/>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Lines}" Margin="18,4,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Where}" Style="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{DynamicResource MonospaceFont}" FontSize="12"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Text}" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="2" Content="Go to" Style="{DynamicResource ButtonSmall}" Margin="8,0,0,0"
                                                                        ToolTip="{Binding GoTip}" Tag="{Binding}" Click="GoTo_Click"
                                                                        Visibility="{Binding CanGo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Style="{DynamicResource ButtonBase}" Margin="6,0,0,0"
                    ToolTip="Close the report (Esc)" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Content="Copy" Style="{DynamicResource ButtonBase}" Margin="6,0,0,0"
                    ToolTip="Copy the report as text (Markdown), to paste into a message or a forum post" Click="Copy_Click"/>
            <Button DockPanel.Dock="Right" Content="Save for the author..." Style="{DynamicResource ButtonAccent}" Margin="6,0,0,0"
                    ToolTip="Save the report as a Markdown file to send to the mod's author: every finding with its line in the file and what the game does with it"
                    Click="Save_Click"/>
            <Button DockPanel.Dock="Left" Content="Check again" Style="{DynamicResource ButtonBase}"
                    ToolTip="Check the mod as it is now, with your edits" Click="Recheck_Click"/>
            <Button DockPanel.Dock="Left" Content="Every issue..." Style="{DynamicResource ButtonBase}" Margin="6,0,0,0"
                    ToolTip="The full list of issues the checks found, with filters" Click="AllIssues_Click"/>
            <TextBlock/>
        </DockPanel>
    </Grid>
</Window>
