<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Dom5Editor.UI.Controls"
                    xmlns:vm="clr-namespace:Dom5Editor.UI.ViewModels"
                    xmlns:views="clr-namespace:Dom5Editor.UI.Views"
                    xmlns:behaviors="clr-namespace:Dom5Editor.UI.Behaviors"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Views for entity pages and their panels (Dom5Editor/UI/ViewModels/Panels.cs). Inherited rows
        are grey; their tooltip says where they come from.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Theme/Converters.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type vm:EntityPageViewModel}">
        <views:EntityPageView/>
    </DataTemplate>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- a small inline value box, like a badge's -->
    <Style x:Key="InlineBox" TargetType="TextBox">
        <Setter Property="Template" Value="{DynamicResource LightTextBoxTemplate}"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsInherited}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- a list of references: weapons, armor, recruits; with columns, a small table -->
    <DataTemplate DataType="{x:Type vm:ReferenceListPanel}">
        <StackPanel Margin="0,0,0,10">
            <!-- the title, and the column headers laid out like a row (hidden copies of its buttons keep them aligned) -->
            <Border Padding="2,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" Visibility="Hidden" Height="1"/>
                    <Button DockPanel.Dock="Right" Content="→" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" Visibility="Hidden" Height="1"/>
                    <Button DockPanel.Dock="Right" Content="Copy &amp; edit" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" Height="1"
                            Visibility="{Binding CanCopyEdit, Converter={StaticResource BoolToVisibilityConverter}}" Opacity="0" IsHitTestVisible="False"/>
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Columns}" VerticalAlignment="Bottom"
                                  Visibility="{Binding IsTable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Width="58" ToolTip="{Binding Tooltip}" Background="Transparent" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                        <controls:GameIcon Kind="{Binding Icon}" Width="12" Height="12" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding Header}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" VerticalAlignment="Bottom"/>
                </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PanelRow}">
                        <Border Padding="2,1" CornerRadius="3" Background="Transparent" x:Name="RowBorder" ToolTip="{Binding Source}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0"
                                        ToolTip="{Binding RemoveTip}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button DockPanel.Dock="Right" Content="→" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0"
                                        ToolTip="{Binding OpenTip}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button DockPanel.Dock="Right" Content="Copy &amp; edit" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0"
                                        ToolTip="{Binding CopyTip}"
                                        Command="{Binding DataContext.CopyEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding DataContext.CanCopyEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Width="58" Padding="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{DynamicResource MonospaceFont}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource TextMutedBrush}"
                                           FontFamily="{DynamicResource MonospaceFont}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RefId, StringFormat='#{0}'}" Width="48" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Text}" Style="{StaticResource RowText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <controls:SearchableReferenceComboBox Width="260" Height="22" HorizontalAlignment="Left"
                                                      ItemsSource="{Binding Candidates}" SelectedId="{Binding AddPick, Mode=TwoWay}"
                                                      Placeholder="+ Add..." ToolTip="{Binding AddTip}"/>
                <Button Content="{Binding NewLabel}" Style="{DynamicResource ButtonSmall}" Margin="6,0,0,0" Command="{Binding NewCommand}"
                        ToolTip="{Binding NewTip}"
                        Visibility="{Binding CanMakeNew, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </DataTemplate>

    <!-- a magic path as an icon button: on/off for a random path's mask -->
    <Style x:Key="PathToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="2">
                        <controls:GameIcon x:Name="I" Kind="{Binding Icon}" Width="18" Height="18" Opacity="0.25"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="I" Property="Opacity" Value="1"/>
                            <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="#55FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a path to add: its icon, faint until pointed at -->
    <Style x:Key="PathAddButton" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="2">
                        <controls:GameIcon x:Name="I" Kind="{Binding Icon}" Width="18" Height="18" Opacity="0.45"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="I" Property="Opacity" Value="1"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the ten path toggles of one random path -->
    <DataTemplate x:Key="PathTogglesTemplate">
        <ItemsControl ItemsSource="{Binding Toggles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PathToggle}">
                    <ToggleButton IsChecked="{Binding IsOn, Mode=TwoWay}" Style="{StaticResource PathToggle}" ToolTip="{Binding Name, Converter={StaticResource Format}, ConverterParameter='{}{0}: lit means this random path can be {0}'}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- a monster's magic: paths as icon chips, paths to add, random paths as toggle rows -->
    <DataTemplate DataType="{x:Type vm:MagicPanel}">
        <StackPanel Margin="0,0,0,10" x:Name="MagicRoot">
            <DockPanel>
                <TextBlock Text="MAGIC" Style="{StaticResource PanelTitle}"/>
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="10,0,0,3"
                           FontFamily="{DynamicResource MonospaceFont}"/>
            </DockPanel>
            <WrapPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Paths}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PanelRow}">
                            <Border Background="#18FFFFFF" CornerRadius="4" Padding="4,2" Margin="0,0,6,4" ToolTip="{Binding Source}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GameIcon Kind="{Binding Icon}" Width="20" Height="20" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource RowText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True"
                                             Width="26" TextAlignment="Center" Style="{StaticResource InlineBox}"
                                             ToolTip="{Binding Text, Converter={StaticResource Format}, ConverterParameter='{}{0} level (0 removes the path)'}"/>
                                    <Button Content="✕" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0"
                                            ToolTip="{Binding Text, Converter={StaticResource Format}, ConverterParameter='Remove {0} magic'}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                <TextBlock Text="Add a path:" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ItemsControl ItemsSource="{Binding AddablePaths}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PathToggle}">
                            <Button Style="{StaticResource PathAddButton}" ToolTip="{Binding Name, Converter={StaticResource Format}, ConverterParameter='Add {0} magic (level 1)'}"
                                    Command="{Binding DataContext.AddPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="RANDOM PATHS (each line: a level in one of the lit paths, at that chance; over 100%: more levels)" Style="{StaticResource PanelTitle}"/>
            <ItemsControl ItemsSource="{Binding Random}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RandomPathRow}">
                        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Source}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PathTogglesTemplate}"/>
                            <TextBox Text="{Binding Chance, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True"
                                     Width="34" TextAlignment="Right" Margin="8,0,0,0" Style="{StaticResource InlineBox}" ToolTip="Chance in percent: 100 is certain; over 100 is a linked random (200: +2 levels in the same path)"/>
                            <TextBlock Text="%" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <Button Content="✕" Style="{DynamicResource ButtonSmall}" Margin="8,0,0,0" ToolTip="Remove this random path"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                            <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,4,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" DataContext="{Binding NewRandom}">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PathTogglesTemplate}"
                                      ToolTip="Light the paths it can roll among"/>
                    <TextBox Text="{Binding Chance, UpdateSourceTrigger=PropertyChanged}" Width="34" TextAlignment="Right" Margin="8,0,0,0"
                             Style="{StaticResource InlineBox}" ToolTip="Chance in percent: 100 is certain; over 100 is a linked random (200: +2 levels in the same path)"/>
                    <TextBlock Text="%" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    <Button Content="+ Add random path" Style="{DynamicResource ButtonSmall}" Margin="8,0,0,0"
                            Command="{Binding DataContext.AddRandomCommand, ElementName=MagicRoot}"
                            ToolTip="Adds #custommagic with the lit paths and the chance"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </DataTemplate>

    <!-- a field's label: grey while the value is inherited -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Width" Value="110"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsInherited}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- back to what it inherits: only while the mod sets the value itself -->
    <Style x:Key="ResetButton" TargetType="Button">
        <Setter Property="Content" Value="↺"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="3,0,0,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Command" Value="{Binding ResetCommand}"/>
        <Setter Property="ToolTip" Value="{Binding ResetTip}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#22FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding CanReset}" Value="False">
                <Setter Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- a label with its icon (none: just the label) -->
    <DataTemplate x:Key="FieldLabelTemplate">
        <StackPanel Orientation="Horizontal" Width="130">
            <controls:GameIcon Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Width="NaN"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChoiceField}">
        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Tooltip}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <ComboBox Width="220" ItemsSource="{Binding Options}" SelectedValuePath="Value"
                      SelectedValue="{Binding Selected, Mode=TwoWay}" Style="{DynamicResource ComboBoxBase}" Padding="6,2">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChoiceOption}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GameIcon Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,5,0"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Style="{StaticResource ResetButton}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CommandChoiceField}">
        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Tooltip}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <ComboBox Width="220" ItemsSource="{Binding Options}" DisplayMemberPath="Name" SelectedValuePath="Value"
                      SelectedValue="{Binding Selected, Mode=TwoWay}" Style="{DynamicResource ComboBoxBase}" Padding="6,2"/>
            <Button Style="{StaticResource ResetButton}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NumberField}">
        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Tooltip}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <TextBox Text="{Binding Text, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="80" Style="{StaticResource InlineBox}"/>
            <Button Style="{StaticResource ResetButton}"/>
            <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RefField}">
        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Tooltip}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldLabelTemplate}"/>
            <controls:SearchableReferenceComboBox Width="260" Height="22" ItemsSource="{Binding Candidates}"
                                                  SelectedId="{Binding SelectedId, Mode=TwoWay}" Placeholder="(none)"/>
            <Button Content="→" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" Command="{Binding OpenCommand}" ToolTip="{Binding OpenTip}"/>
            <Button Style="{StaticResource ResetButton}"/>
            <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- a nation's army in rows: role, unit, how many -->
    <DataTemplate DataType="{x:Type vm:ArmyPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}"/>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource AccentHighlightBrush}" Margin="0,6,0,2"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:UnitRowField}">
                        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Unit.Tooltip}">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Width="130"/>
                            <controls:SearchableReferenceComboBox Width="260" Height="22" ItemsSource="{Binding Unit.Candidates}"
                                                                  SelectedId="{Binding Unit.SelectedId, Mode=TwoWay}" Placeholder="(none)"/>
                            <Button Content="→" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" Command="{Binding Unit.OpenCommand}" ToolTip="{Binding Unit.OpenTip}"/>
                            <Button Style="{StaticResource ResetButton}" DataContext="{Binding Unit}"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="{Binding Count.Tooltip}">
                                <TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                <TextBox Text="{Binding Count.Text, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True"
                                         Width="44" TextAlignment="Right" Style="{StaticResource InlineBox}"/>
                                <Button Style="{StaticResource ResetButton}" DataContext="{Binding Count}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- flags in groups, each a checkbox (a weapon's qualities) -->
    <DataTemplate DataType="{x:Type vm:FlagsPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Width="110" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <ItemsControl ItemsSource="{Binding Flags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FlagField}">
                                        <CheckBox IsChecked="{Binding IsOn}" Margin="0,1,14,1" Style="{DynamicResource CheckBoxBase}" ToolTip="{Binding Tooltip}">
                                            <TextBlock Text="{Binding Label}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInherited}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- one stat of the unit window: icon, label, value (right-aligned), reset -->
    <DataTemplate x:Key="StatCell" DataType="{x:Type vm:NumberField}">
        <DockPanel Height="26" ToolTip="{Binding Tooltip}" Background="Transparent">
            <controls:GameIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource ResetButton}"/>
            <TextBox DockPanel.Dock="Right" Text="{Binding Text, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True"
                     Width="56" TextAlignment="Right" FontSize="12" Style="{StaticResource InlineBox}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="6,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Width="NaN" FontSize="12"/>
        </DockPanel>
    </DataTemplate>

    <!-- one leadership of the unit window: class and bonus, the total as the game shows it -->
    <DataTemplate x:Key="LeaderCell" DataType="{x:Type vm:LeaderField}">
        <DockPanel Height="26" Background="Transparent" ToolTip="{Binding Hint}">
            <controls:GameIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource ResetButton}" DataContext="{Binding Bonus}"/>
            <TextBox DockPanel.Dock="Right" Text="{Binding Bonus.Text, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True"
                     Width="30" TextAlignment="Right" FontSize="12" Style="{StaticResource InlineBox}" ToolTip="{Binding Bonus.Tooltip}"/>
            <TextBlock DockPanel.Dock="Right" Text="+" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="3,0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource ResetButton}" DataContext="{Binding Class}"/>
            <ComboBox DockPanel.Dock="Right" Width="104" ItemsSource="{Binding Class.Options}" DisplayMemberPath="Name" SelectedValuePath="Value"
                      SelectedValue="{Binding Class.Selected, Mode=TwoWay}" Style="{DynamicResource ComboBoxBase}" Padding="4,1" FontSize="11"/>
            <TextBlock VerticalAlignment="Center" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInherited}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding Label, Mode=OneWay}"/>
            </TextBlock>
        </DockPanel>
    </DataTemplate>

    <!-- a monster's stats as the game's unit window: three columns, then cost -->
    <DataTemplate DataType="{x:Type vm:StatsPanel}">
        <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}"/>
        <Border Background="#10FFFFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6,6,6" Margin="0,0,0,12">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Cells}" Width="318" Margin="0,0,14,0">
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type vm:NumberField}">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatCell}"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:LeaderField}">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LeaderCell}"/>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding Footer}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NumberField}">
                                <StackPanel Orientation="Horizontal" Height="26" Margin="0,0,28,0" ToolTip="{Binding Tooltip}" Background="Transparent">
                                    <controls:GameIcon Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Width="NaN" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True"
                                             Width="56" TextAlignment="Right" FontSize="12" Style="{StaticResource InlineBox}"/>
                                    <Button Style="{StaticResource ResetButton}"/>
                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>
        </StackPanel>
    </DataTemplate>

    <!-- a nametype's names, one per line -->
    <DataTemplate DataType="{x:Type vm:NamesPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}"/>
            <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="NoWrap"
                     MinHeight="120" MaxHeight="500" VerticalScrollBarVisibility="Auto" Style="{DynamicResource TextBoxBase}"
                     FontFamily="{DynamicResource MonospaceFont}"
                     ToolTip="One name per line. Names added at the end become #addname lines; other changes rewrite the list (#clear and every name)."/>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource WarningBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- a monster's item slots as counts -->
    <DataTemplate DataType="{x:Type vm:ItemSlotsPanel}">
        <StackPanel Margin="0,0,0,10" ToolTip="{Binding Source}">
            <TextBlock Style="{StaticResource PanelTitle}">
                <Run Text="ITEM SLOTS"/><Run Text="{Binding Mask, Mode=OneWay, StringFormat='  (#itemslots {0})'}" Foreground="{DynamicResource TextMutedBrush}"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hands" Width="40" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Hands, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="28" Style="{StaticResource InlineBox}" ToolTip="Hand slots (0-6): weapons and shields"/>
                <TextBlock Text="Heads" Width="40" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Heads, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="28" Style="{StaticResource InlineBox}" ToolTip="Head slots (0-3): helmets and crowns"/>
                <TextBlock Text="Misc" Width="34" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Misc, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="28" Style="{StaticResource InlineBox}" ToolTip="Miscellaneous item slots (0-4)"/>
                <CheckBox Content="Body" IsChecked="{Binding HasBody}" ToolTip="A body armor slot" Margin="12,0,0,0" Style="{DynamicResource CheckBoxBase}" VerticalAlignment="Center"/>
                <CheckBox Content="Feet" IsChecked="{Binding HasFeet}" ToolTip="A boots slot" Margin="8,0,0,0" Style="{DynamicResource CheckBoxBase}" VerticalAlignment="Center"/>
                <CheckBox Content="Bow" IsChecked="{Binding HasBow}" ToolTip="Can use a bow (a two-handed missile weapon) in its hands" Margin="8,0,0,0" Style="{DynamicResource CheckBoxBase}" VerticalAlignment="Center"/>
                <CheckBox Content="Crowns only" IsChecked="{Binding CrownsOnly}" Margin="8,0,0,0" Style="{DynamicResource CheckBoxBase}" VerticalAlignment="Center"
                          ToolTip="Head slots can only have crowns"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- fields of one part of an entity (a spell's paths, an item's slot) -->
    <DataTemplate DataType="{x:Type vm:FieldsPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}"/>
            <ItemsControl ItemsSource="{Binding Fields}"/>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- one row per first argument of a keyed command (a site's gems by path) -->
    <DataTemplate DataType="{x:Type vm:KeyedListPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}"/>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PanelRow}">
                        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Source}">
                            <controls:GameIcon Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Text}" Width="90" Style="{StaticResource RowText}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="50" Style="{StaticResource InlineBox}"/>
                            <TextBlock Text="{Binding DataContext.ValueLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <Button Content="✕" Style="{DynamicResource ButtonSmall}" Margin="6,0,0,0" ToolTip="{Binding Text, Converter={StaticResource Format}, ConverterParameter='Remove {0}'}"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <ItemsControl ItemsSource="{Binding AddableKeys}" Visibility="{Binding HasIconKeys, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChoiceOption}">
                            <Button Style="{StaticResource PathAddButton}" ToolTip="{Binding Name, Converter={StaticResource Format}, ConverterParameter='Add {0}'}"
                                    Command="{Binding DataContext.AddKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:SearchableReferenceComboBox Width="160" Height="22" HorizontalAlignment="Left"
                                                      ItemsSource="{Binding Addable}" SelectedId="{Binding AddPick, Mode=TwoWay}" Placeholder="+ Add..."
                                                      ToolTip="{Binding Title, Converter={StaticResource Format}, ConverterParameter='Add a row to {0}: type to search'}"
                                                      Visibility="{Binding HasIconKeys, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
            </StackPanel>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
