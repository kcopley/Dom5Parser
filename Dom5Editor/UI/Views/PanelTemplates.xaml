<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Dom5Editor.UI.Controls"
                    xmlns:vm="clr-namespace:Dom5Editor.UI.ViewModels"
                    xmlns:views="clr-namespace:Dom5Editor.UI.Views"
                    xmlns:behaviors="clr-namespace:Dom5Editor.UI.Behaviors">
    <!--
        Views for entity pages and their panels (Dom5Editor/UI/ViewModels/Panels.cs). Inherited rows
        are grey; their tooltip says where they come from.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Theme/Converters.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type vm:EntityPageViewModel}">
        <views:EntityPageView/>
    </DataTemplate>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- a small inline value box, like a badge's -->
    <Style x:Key="InlineBox" TargetType="TextBox">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsInherited}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- a list of references: weapons, armor, recruits -->
    <DataTemplate DataType="{x:Type vm:ReferenceListPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}"/>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PanelRow}">
                        <DockPanel Margin="0,1" ToolTip="{Binding Source}">
                            <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0"
                                    ToolTip="Remove" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button DockPanel.Dock="Right" Content="→" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0"
                                    ToolTip="Open" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button DockPanel.Dock="Right" Content="Copy &amp; edit" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0"
                                    ToolTip="Make a new one copying this, use it here instead, and open it (other users keep the old one)"
                                    Command="{Binding DataContext.CopyEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding DataContext.CanCopyEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource TextMutedBrush}"
                                       FontFamily="{DynamicResource MonospaceFont}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RefId, StringFormat='#{0}'}" Width="48" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource RowText}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:SearchableReferenceComboBox Width="260" Height="22" HorizontalAlignment="Left" Margin="0,3,0,0"
                                                  ItemsSource="{Binding Candidates}" SelectedId="{Binding AddPick, Mode=TwoWay}"
                                                  Placeholder="+ Add..."/>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </DataTemplate>

    <!-- a monster's magic paths and random paths -->
    <DataTemplate DataType="{x:Type vm:MagicPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="MAGIC" Style="{StaticResource PanelTitle}"/>
            <ItemsControl ItemsSource="{Binding Paths}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PanelRow}">
                        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Source}">
                            <TextBlock Text="{Binding Text}" Width="70" Style="{StaticResource RowText}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="34" Style="{StaticResource InlineBox}"
                                     ToolTip="Level (0 removes the path)"/>
                            <Button Content="✕" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" ToolTip="Remove"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:SearchableReferenceComboBox Width="160" Height="22" HorizontalAlignment="Left" Margin="0,3,0,6"
                                                  ItemsSource="{Binding AddablePaths}" SelectedId="{Binding AddPathPick, Mode=TwoWay}"
                                                  Placeholder="+ Add path..."/>
            <TextBlock Text="RANDOM PATHS" Style="{StaticResource PanelTitle}"/>
            <ItemsControl ItemsSource="{Binding Random}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PanelRow}">
                        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Source}">
                            <TextBlock Text="{Binding Text}" Width="70" Style="{StaticResource RowText}" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource MonospaceFont}"/>
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="40" Style="{StaticResource InlineBox}"
                                     ToolTip="Chance in percent"/>
                            <TextBlock Text="%" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <Button Content="✕" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" ToolTip="Remove"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBox x:Name="NewRandom" Width="90" Style="{StaticResource InlineBox}" ToolTip="Paths as letters: F A W E S D N G B H (e.g. FAWE)"/>
                <Button Content="+ Add random" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0"
                        Command="{Binding AddRandomCommand}" CommandParameter="{Binding Text, ElementName=NewRandom}"/>
            </StackPanel>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </DataTemplate>
    <!-- a field's label: grey while the value is inherited -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Width" Value="110"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsInherited}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate DataType="{x:Type vm:ChoiceField}">
        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Tooltip}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
            <ComboBox Width="220" ItemsSource="{Binding Options}" DisplayMemberPath="Name" SelectedValuePath="Value"
                      SelectedValue="{Binding Selected, Mode=TwoWay}" Style="{DynamicResource ComboBoxBase}" Padding="6,2"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CommandChoiceField}">
        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Tooltip}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
            <ComboBox Width="220" ItemsSource="{Binding Options}" DisplayMemberPath="Name" SelectedValuePath="Value"
                      SelectedValue="{Binding Selected, Mode=TwoWay}" Style="{DynamicResource ComboBoxBase}" Padding="6,2"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NumberField}">
        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Tooltip}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Text, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="80" Style="{StaticResource InlineBox}"/>
            <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RefField}">
        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Tooltip}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}"/>
            <controls:SearchableReferenceComboBox Width="260" Height="22" ItemsSource="{Binding Candidates}"
                                                  SelectedId="{Binding SelectedId, Mode=TwoWay}" Placeholder="(none)"/>
            <Button Content="→" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" Command="{Binding OpenCommand}" ToolTip="Open"/>
        </StackPanel>
    </DataTemplate>

    <!-- a nametype's names, one per line -->
    <DataTemplate DataType="{x:Type vm:NamesPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}"/>
            <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="NoWrap"
                     MinHeight="120" MaxHeight="500" VerticalScrollBarVisibility="Auto" Style="{DynamicResource TextBoxBase}"
                     FontFamily="{DynamicResource MonospaceFont}"
                     ToolTip="One name per line. Names added at the end become #addname lines; other changes rewrite the list (#clear and every name)."/>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource WarningBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- a monster's item slots as counts -->
    <DataTemplate DataType="{x:Type vm:ItemSlotsPanel}">
        <StackPanel Margin="0,0,0,10" ToolTip="{Binding Source}">
            <TextBlock Style="{StaticResource PanelTitle}">
                <Run Text="ITEM SLOTS"/><Run Text="{Binding Mask, Mode=OneWay, StringFormat='  (#itemslots {0})'}" Foreground="{DynamicResource TextMutedBrush}"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hands" Width="40" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Hands, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="28" Style="{StaticResource InlineBox}" ToolTip="0-6"/>
                <TextBlock Text="Heads" Width="40" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Heads, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="28" Style="{StaticResource InlineBox}" ToolTip="0-3"/>
                <TextBlock Text="Misc" Width="34" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Misc, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="28" Style="{StaticResource InlineBox}" ToolTip="0-4"/>
                <CheckBox Content="Body" IsChecked="{Binding HasBody}" Margin="12,0,0,0" Style="{DynamicResource CheckBoxBase}" VerticalAlignment="Center"/>
                <CheckBox Content="Feet" IsChecked="{Binding HasFeet}" Margin="8,0,0,0" Style="{DynamicResource CheckBoxBase}" VerticalAlignment="Center"/>
                <CheckBox Content="Bow" IsChecked="{Binding HasBow}" Margin="8,0,0,0" Style="{DynamicResource CheckBoxBase}" VerticalAlignment="Center"/>
                <CheckBox Content="Crowns only" IsChecked="{Binding CrownsOnly}" Margin="8,0,0,0" Style="{DynamicResource CheckBoxBase}" VerticalAlignment="Center"
                          ToolTip="Head slots can only have crowns"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- fields of one part of an entity (a spell's paths, an item's slot) -->
    <DataTemplate DataType="{x:Type vm:FieldsPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}"/>
            <ItemsControl ItemsSource="{Binding Fields}"/>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>

    <!-- one row per first argument of a keyed command (a site's gems by path) -->
    <DataTemplate DataType="{x:Type vm:KeyedListPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}"/>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PanelRow}">
                        <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Source}">
                            <TextBlock Text="{Binding Text}" Width="110" Style="{StaticResource RowText}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True" Width="50" Style="{StaticResource InlineBox}"/>
                            <TextBlock Text="{Binding DataContext.ValueLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <Button Content="✕" Style="{DynamicResource ButtonSmall}" Margin="6,0,0,0" ToolTip="Remove"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:SearchableReferenceComboBox Width="160" Height="22" HorizontalAlignment="Left" Margin="0,3,0,0"
                                                  ItemsSource="{Binding Addable}" SelectedId="{Binding AddPick, Mode=TwoWay}" Placeholder="+ Add..."/>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
