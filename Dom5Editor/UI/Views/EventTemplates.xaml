<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Dom5Editor.UI.Controls"
                    xmlns:vm="clr-namespace:Dom5Editor.UI.ViewModels"
                    xmlns:behaviors="clr-namespace:Dom5Editor.UI.Behaviors"
                    xmlns:events="clr-namespace:Dom5Edit.Events;assembly=Dom5Edit">
    <!--
        The event page (UI/ViewModels/EventPage.cs, docs/EVENT_EDITOR.md E-3): how it's rolled and
        owned, the message, requirements by group, effects in order, and how it chains.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Theme/Converters.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="EventTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="EventBox" TargetType="Border">
        <Setter Property="Background" Value="#10FFFFFF"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="EventBoxText" TargetType="TextBox">
        <Setter Property="Template" Value="{DynamicResource LightTextBoxTemplate}"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- a link to an event or spell on the other end of a line -->
    <DataTemplate DataType="{x:Type vm:LinkChip}">
        <Button Command="{Binding OpenCommand}" Margin="6,1,0,1" Padding="5,0" Cursor="Hand" ToolTip="{Binding Tooltip}"
                Style="{DynamicResource ButtonSmall}" VerticalAlignment="Center">
            <TextBlock>
                <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}"/>
                <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource AccentHighlightBrush}"/>
            </TextBlock>
        </Button>
    </DataTemplate>

    <!-- a spell's events (its enchantment's, or the ones it causes) -->
    <DataTemplate DataType="{x:Type vm:SpellEventsPanel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource EventTitle}"/>
            <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,2"
                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="{Binding NewLabel}" Command="{Binding NewCommand}" Style="{DynamicResource ButtonSmall}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    ToolTip="Makes an event (always, unlimited) that requires this enchantment, once a month, or that has this spell's event id; opens it"/>
        </StackPanel>
    </DataTemplate>

    <!-- how it's rolled and who owns it -->
    <DataTemplate DataType="{x:Type vm:EventHeaderPanel}">
        <Border Style="{StaticResource EventBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ROLLED AS" Style="{StaticResource EventTitle}" VerticalAlignment="Center" Margin="0"/>
                <ComboBox Grid.Column="1" Width="230" ItemsSource="{Binding Rarities}" DisplayMemberPath="Name" SelectedValuePath="Value"
                          SelectedValue="{Binding Rarity, Mode=TwoWay}" Style="{DynamicResource ComboBoxBase}" Padding="6,2"
                          ToolTip="{Binding RarityTooltip}"/>
                <TextBlock Grid.Column="2" Text="{Binding RarityMeaning}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Grid.Row="1" Text="OWNED BY" Style="{StaticResource EventTitle}" VerticalAlignment="Center" Margin="0,6,0,0"
                           ToolTip="The nation that gets the event's units, gold and message"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Width="230" Margin="0,6,0,0" ItemsSource="{x:Static vm:EventHeaderPanel.OwnerOptions}"
                          DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Owner, Mode=TwoWay}"
                          Style="{DynamicResource ComboBoxBase}" Padding="6,2" ToolTip="{Binding OwnerTooltip}"/>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="10,6,0,0">
                    <controls:SearchableReferenceComboBox Width="240" Height="22" ItemsSource="{Binding Nations}" SelectedId="{Binding OwnerNation, Mode=TwoWay}"
                                                          Placeholder="(pick a nation)"
                                                          Visibility="{Binding IsNationOwner, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsEnchantmentOwner, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="enchantment" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding OwnerEnchantment, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True"
                                 Width="60" Style="{StaticResource EventBoxText}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- the message, its tags, header and options, the site or item it names -->
    <DataTemplate DataType="{x:Type vm:EventMessagePanel}">
        <StackPanel Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LengthText}" FontSize="10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTooLong}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="MESSAGE" Style="{StaticResource EventTitle}"/>
            </DockPanel>
            <TextBox x:Name="MessageBox" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" AcceptsReturn="True"
                     MinHeight="70" MaxHeight="220" VerticalScrollBarVisibility="Auto" Style="{DynamicResource TextBoxBase}"
                     ToolTip="{Binding Tooltip}"/>
            <WrapPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="Insert:" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ItemsControl ItemsSource="{x:Static vm:EventMessagePanel.Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Tag}" Tag="{Binding Tag}" ToolTip="{Binding Meaning}" Focusable="False"
                                    Style="{DynamicResource ButtonSmall}" Margin="0,0,3,3" FontSize="9" Padding="4,0"
                                    behaviors:InsertTextBehavior.Target="{Binding ElementName=MessageBox}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
            <Expander Header="PREVIEW (as the player reads it, with sample names)" Margin="0,2,0,2" Foreground="{DynamicResource TextSecondaryBrush}"
                      FontSize="9" FontWeight="Bold">
                <Border Background="#14FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>
            </Expander>
            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Header" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="290" ItemsSource="{Binding HeaderOptions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                          SelectedValue="{Binding Header, Mode=TwoWay}" Style="{DynamicResource ComboBoxBase}" Padding="6,1"/>
                <CheckBox Content="No message (#notext)" IsChecked="{Binding NoTextValue}" Margin="14,0,0,0" VerticalAlignment="Center"
                          Style="{DynamicResource CheckBoxBase}" ToolTip="The event doesn't send a message"/>
                <CheckBox Content="Not in the chronicle (#nolog)" IsChecked="{Binding NoLogValue}" Margin="12,0,0,0" VerticalAlignment="Center"
                          Style="{DynamicResource CheckBoxBase}" ToolTip="The event doesn't appear in the province's history"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasNamed, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding NamedNote}" VerticalAlignment="Center"
                           ToolTip="The name in brackets at the end of the message: site requirements and effects (#req_site, #revealsite, #addsite -1) and #magicitem 9 use it">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NamedIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="→" Style="{DynamicResource ButtonSmall}" Margin="6,0,0,0" Command="{Binding OpenNamedCommand}"
                        Visibility="{Binding OpenNamedCommand, Converter={StaticResource NullToVisibilityConverter}}" ToolTip="Open it"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- one line: its sentence, the value editable in place, links -->
    <DataTemplate DataType="{x:Type vm:EventLineRow}">
        <Border x:Name="Row" Padding="4,1" CornerRadius="3" Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="600">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" ToolTip="Remove this line"
                        Command="{Binding RemoveCommand}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="↓" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" ToolTip="Move down (order matters: some lines act on the ones after them)"
                        Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" VerticalAlignment="Center"
                        Visibility="{Binding DataContext.IsRequirements, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                <Button DockPanel.Dock="Right" Content="↑" Style="{DynamicResource ButtonSmall}" Margin="4,0,0,0" ToolTip="Move up (order matters: some lines act on the ones after them)"
                        Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" VerticalAlignment="Center"
                        Visibility="{Binding DataContext.IsRequirements, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                <controls:GameIcon DockPanel.Dock="Left" Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"/>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Before}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <!-- a number -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=Explicit}" behaviors:DebouncedTextBoxBehavior.IsEnabled="True"
                                 MinWidth="40" TextAlignment="Center" Margin="3,0" Style="{StaticResource EventBoxText}"/>
                        <TextBlock Text="{Binding Suffix}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <!-- one of a list -->
                    <ComboBox ItemsSource="{Binding Options}" SelectedValuePath="Value" SelectedValue="{Binding Selected, Mode=TwoWay}"
                              Style="{DynamicResource ComboBoxBase}" Padding="5,0" Margin="3,0" MinWidth="90" Height="22"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChoiceOption}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:GameIcon Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,4,0"
                                                       Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- yes or no: the two sentences -->
                    <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Selected, Mode=TwoWay}"
                              Style="{DynamicResource ComboBoxBase}" Padding="5,0" Height="22" MinWidth="200"
                              Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- an entity -->
                    <StackPanel Orientation="Horizontal" Margin="3,0" Visibility="{Binding IsRef, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:SearchableReferenceComboBox Width="220" Height="22" ItemsSource="{Binding Candidates}" SelectedId="{Binding RefId, Mode=TwoWay}"
                                                              Placeholder="(pick)"/>
                        <Button Content="→" Style="{DynamicResource ButtonSmall}" Margin="3,0,0,0" Command="{Binding OpenCommand}" ToolTip="Open it"/>
                    </StackPanel>
                    <!-- flags (orders, afflictions, terrain) -->
                    <Grid Margin="3,0" Visibility="{Binding IsMask, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ToggleButton x:Name="MaskToggle" Padding="6,0" Height="22" MinWidth="120" HorizontalContentAlignment="Left"
                                      Background="#1AFFFFFF" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="#40FFFFFF" ToolTip="Pick which">
                            <TextBlock Text="{Binding MaskWords}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=MaskToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=MaskToggle}"
                               Placement="Bottom" AllowsTransparency="True">
                            <Border Background="{DynamicResource BackgroundMediumBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="6" CornerRadius="3" MaxHeight="360">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding MaskOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MaskOption}">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,1" Style="{DynamicResource CheckBoxBase}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock Text="{Binding After}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding Links}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Info}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                               Visibility="{Binding HasInfo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </WrapPanel>
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#12FFFFFF"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- requirements by group, or effects in order -->
    <DataTemplate DataType="{x:Type vm:EventLinesPanel}">
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource EventTitle}"/>
            <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,4"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:EventLineGroup}">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Title}" FontSize="10" Foreground="{DynamicResource AccentHighlightBrush}" Margin="4,2,0,1"
                                       Visibility="{Binding Title, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding Rows}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:SearchableReferenceComboBox Width="460" Height="22" HorizontalAlignment="Left" Margin="4,3,0,0"
                                                  ItemsSource="{Binding Addable}" SelectedId="{Binding AddPick, Mode=TwoWay}"
                                                  Placeholder="{Binding AddPlaceholder}"/>
        </StackPanel>
    </DataTemplate>

    <!-- how the event chains, its problems, making follow-ups -->
    <DataTemplate DataType="{x:Type vm:EventChainPanel}">
        <Border Style="{StaticResource EventBox}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Position}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                    <TextBlock Text="CHAIN" Style="{StaticResource EventTitle}"/>
                </DockPanel>
                <TextBlock Text="{Binding ChainText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasStartedBy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Started by" Width="80" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <ItemsControl ItemsSource="{Binding StartedBy}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasComesFrom, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Comes from" Width="80" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <ItemsControl ItemsSource="{Binding ComesFrom}" MaxWidth="900">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasLeadsTo, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Leads to" Width="80" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <ItemsControl ItemsSource="{Binding LeadsTo}" MaxWidth="900">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <Expander IsExpanded="{Binding MapOpen, Mode=OneTime}" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                          FontSize="9" FontWeight="Bold" Visibility="{Binding HasMap, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Expander.Header>
                        <TextBlock>
                            <Run Text="{Binding MapTitle, Mode=OneWay}"/>
                            <Run Text="  code" Foreground="#E0A040" FontWeight="Normal"/><Run Text="  delay" Foreground="#5BA8F5" FontWeight="Normal"/>
                            <Run Text="  variable" Foreground="#4CC38A" FontWeight="Normal"/><Run Text="  choice" Foreground="#B07CF7" FontWeight="Normal"/>
                            <Run Text="  blocks" Foreground="#E5484D" FontWeight="Normal"/><Run Text="  spell" Foreground="#9CA3AF" FontWeight="Normal"/>
                        </TextBlock>
                    </Expander.Header>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="520" Margin="0,4,0,0">
                        <controls:ChainGraph Nodes="{Binding MapNodes}" Edges="{Binding MapEdges}" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Expander>
                <ItemsControl ItemsSource="{Binding Problems}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type events:EventProblem}">
                            <TextBlock TextWrapping="Wrap" Margin="0,1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        <Setter Property="Text" Value="{Binding Message, StringFormat='⚠ {0}'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="#E5484D"/>
                                                <Setter Property="Text" Value="{Binding Message, StringFormat='⛔ {0}'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+ Follow-up when this happens" Style="{DynamicResource ButtonSmall}" Command="{Binding FollowUpCommand}" Margin="0,0,6,0"
                            ToolTip="Sets a province code here (#code, with #req_code 0 if this event requires none) and makes an event that requires it and ends the chain (#code 0)"/>
                    <Button Content="+ Delayed follow-up" Style="{DynamicResource ButtonSmall}" Command="{Binding DelayedCommand}" Margin="0,0,6,0"
                            ToolTip="Adds #delay 1 here and makes an event right after this one in the file: the game runs it a turn later"/>
                    <Button Content="+ Player choice (accept / decline)" Style="{DynamicResource ButtonSmall}" Command="{Binding ChoiceCommand}"
                            ToolTip="Offers Accept and Decline in the province (#order 12) with a code, and makes an event for each answer (#req_targorder 102 / 103)"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
