<Window x:Class="Dom5Editor.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Dom5Editor.UI.Controls"
        xmlns:views="clr-namespace:Dom5Editor.UI.Views"
        xmlns:coreviews="clr-namespace:Dom5Editor.UI.Views;assembly=Dom5Editor.Core"
        xmlns:vm="clr-namespace:Dom5Editor.UI.ViewModels;assembly=Dom5Editor.Core"
        mc:Ignorable="d"
        Title="Dom6 Mod Editor"
        Height="900" Width="1400"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================
             TOOLBAR
             ======================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <!-- left: file, undo, back/forward; then "go to" (it takes the room left, within limits), validate; right: the mod's name -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="140" MaxWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="NewButton"
                            Content="New"
                            ToolTip="Start a new, empty mod (Ctrl+N)"
                            Style="{StaticResource ButtonBase}"
                            Margin="0,0,4,0"
                            Click="NewButton_Click"/>
                    <Button x:Name="LoadButton"
                            Content="Load"
                            ToolTip="Open a .dm mod file (Ctrl+O)"
                            Style="{StaticResource ButtonBase}"
                            Margin="0,0,0,0"
                            Click="LoadButton_Click"/>
                    <Button Content="▾"
                            Style="{StaticResource ButtonBase}"
                            Margin="0,0,4,0"
                            Padding="6,0"
                            ToolTip="Open a mod you worked on recently"
                            Click="RecentButton_Click"/>
                    <Button x:Name="SaveButton"
                            Content="Save"
                            ToolTip="Save the mod (Ctrl+S)"
                            Style="{StaticResource ButtonBase}"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding HasMod}"
                            Click="SaveButton_Click"/>
                    <Button x:Name="SaveAsButton"
                            Content="Save As"
                            ToolTip="Save the mod to a new file (Ctrl+Shift+S)"
                            Style="{StaticResource ButtonBase}"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding HasMod}"
                            Click="SaveAsButton_Click"/>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,10,2"/>

                    <Button x:Name="UndoButton"
                            Content="Undo"
                            Style="{StaticResource ButtonBase}"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanUndo}"
                            ToolTip="{Binding UndoTip}"
                            Click="UndoButton_Click"/>
                    <Button x:Name="RedoButton"
                            Content="Redo"
                            Style="{StaticResource ButtonBase}"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CanRedo}"
                            ToolTip="{Binding RedoTip}"
                            Click="RedoButton_Click"/>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,2,10,2"/>

                    <Button Content="◀" Padding="10,0"
                            Style="{StaticResource ButtonBase}"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanGoBack}"
                            ToolTip="Back to the previous entity (Alt+Left)"
                            Click="BackButton_Click"/>
                    <Button Content="▶" Padding="10,0"
                            Style="{StaticResource ButtonBase}"
                            IsEnabled="{Binding CanGoForward}"
                            ToolTip="Forward to the next entity (Alt+Right)"
                            Click="ForwardButton_Click"/>
                </StackPanel>

                <controls:SearchableReferenceComboBox x:Name="JumpBox" Grid.Column="1"
                                                      MaxWidth="380" Height="24" Margin="12,0,8,0" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding HasMod}"
                                                      ItemsSource="{Binding JumpTargets}"
                                                      Placeholder="Go to any entity... (Ctrl+P)"
                                                      ToolTip="Go to any monster, weapon, spell, nation, event... by name or ID (Ctrl+P)"
                                                      GotKeyboardFocus="JumpBox_GotKeyboardFocus"
                                                      SelectionChanged="JumpBox_SelectionChanged"/>
                <Button x:Name="ValidateButton" Grid.Column="2"
                        Content="Validate"
                        ToolTip="Check the mod for problems (unread lines, missing references, ID clashes)"
                        Style="{StaticResource ButtonBase}"
                        IsEnabled="{Binding HasMod}"
                        Click="ValidateButton_Click"/>

                <!-- the mod's name: trimmed when the window is narrow (the whole name in its tooltip) -->
                <DockPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="ModifiedIndicator"
                               Text="*"
                               Style="{StaticResource HeaderText}"
                               Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"
                               ToolTip="Unsaved changes"
                               Margin="0,0,6,0" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="ModNameDisplay"
                               Text="{Binding ModName, FallbackValue='No mod loaded'}"
                               ToolTip="{Binding ModName, FallbackValue='No mod loaded'}"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource SubHeaderText}"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ========================================
             REPORT BAR: what the check on opening found (MainWindowViewModel.CheckOnOpen)
             ======================================== -->
        <Border x:Name="ReportBar" Grid.Row="1"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="0,5,12,5"
                Visibility="{Binding ShowReportBar, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Rectangle x:Name="ReportMark" Width="4" Margin="0,-5,10,-5" DockPanel.Dock="Left">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReportHasWrong}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ReportIsClean}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource AccentPrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ButtonSmall}" Padding="6,0" Margin="6,0,0,0"
                        ToolTip="Hide this bar (Validate shows the report again)" Click="ReportBarClose_Click"/>
                <Button DockPanel.Dock="Right" Content="Save for the author..." Style="{StaticResource ButtonSmall}" Margin="6,0,0,0"
                        ToolTip="Save the report as a Markdown file to send to the mod's author: every finding with its line in the file and what the game does with it"
                        Click="ReportSave_Click"/>
                <Button DockPanel.Dock="Right" Content="Open report" Style="{StaticResource ButtonSmall}" Margin="6,0,0,0"
                        ToolTip="See what the check found, section by section, with a Go to for each line"
                        Click="ReportOpen_Click"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReportSummary}" ToolTip="{Binding ReportSummary}"
                               Style="{StaticResource TextBlockBase}" TextTrimming="CharacterEllipsis"/>
                    <!-- a submod opened alone: the mod it probably needs (NeededModFinder) -->
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding HasNeededSuggestion, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button DockPanel.Dock="Right" Content="Read it over that mod" Style="{StaticResource ButtonSmall}" Margin="6,0,0,0"
                                ToolTip="Read the mod again over the other one, as the game does when that one is enabled first (remembered for this mod; change it on Mod Info)"
                                Click="NeededSuggestion_Click"/>
                        <TextBlock Text="{Binding NeededSuggestionText}" ToolTip="{Binding NeededSuggestion}"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================
             MAIN CONTENT: the mod header, then a tab per entity type (MainWindowViewModel.Tabs)
             ======================================== -->
        <TabControl x:Name="EntityTabs"
                    Grid.Row="2"
                    Style="{StaticResource TabControlBase}"
                    IsEnabled="{Binding HasMod}"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    SelectionChanged="EntityTabs_SelectionChanged">
            <!-- the tabs in one row (all fit from about 1000 px wide; narrower, the row scrolls: the mouse wheel moves it) -->
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource BackgroundMediumBrush}">
                            <ScrollViewer x:Name="TabStrip" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Focusable="False" PreviewMouseWheel="TabStrip_PreviewMouseWheel">
                                <ScrollViewer.Resources>
                                    <!-- a thin bar under the tabs, only when they don't fit -->
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Height" Value="5"/>
                                        <Setter Property="MinHeight" Value="5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Track x:Name="PART_Track">
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="{StaticResource BorderBrush}" CornerRadius="2"/>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabItemBase}">
                    <Setter Property="Header" Value="{Binding Title}"/>
                    <Setter Property="Padding" Value="11,8"/>
                    <Setter Property="FontSize" Value="12.5"/>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.Resources>
                <DataTemplate DataType="{x:Type coreviews:ModInfoViewModel}">
                    <Border Background="{StaticResource BackgroundDarkBrush}" Padding="16">
                        <views:ModInfoView/>
                    </Border>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:EntityTypeTab}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" MinWidth="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:EntityListControl Grid.Column="0"
                                                    EntityType="{Binding Title}"
                                                    Entities="{Binding Items}"
                                                    SelectedEntity="{Binding SelectedItem, Mode=TwoWay}"
                                                    SearchText="{Binding SearchText}"
                                                    ShowVanilla="{Binding ShowVanilla}"
                                                    ShowModified="{Binding ShowModified}"
                                                    ShowNew="{Binding ShowNew}"
                                                    SortBy="{Binding SortBy}"
                                                    Facets="{Binding Facets}"
                                                    Facet="{Binding Facet}"
                                                    NewCommand="{Binding NewCommand}"
                                                    DeleteCommand="{Binding DeleteCommand}"/>
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                      Background="{StaticResource BorderBrush}"/>
                        <Border Grid.Column="2" Background="{StaticResource BackgroundDarkBrush}" Padding="16">
                            <ContentControl Content="{Binding Page}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </TabControl.Resources>
        </TabControl>

        <!-- ========================================
             STATUS BAR
             ======================================== -->
        <Border Grid.Row="3"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           Text="{Binding StatusMessage, FallbackValue='Ready'}"
                           Style="{StaticResource MutedText}"
                           DockPanel.Dock="Left"/>
                <TextBlock x:Name="EntityCountText"
                           Text="{Binding EntityCount, StringFormat='Entities: {0}'}"
                           Style="{StaticResource MutedText}"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- ========================================
             NO MOD LOADED OVERLAY
             ======================================== -->
        <Border x:Name="NoModOverlay"
                Grid.Row="2"
                Background="{StaticResource BackgroundDarkBrush}"
                Visibility="{Binding HasMod, Converter={StaticResource BoolToVisibilityInverseConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="No mod loaded"
                           Style="{StaticResource HeaderText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <TextBlock Text="Load an existing mod or create a new one to get started."
                           Style="{StaticResource SubHeaderText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="New Mod"
                            ToolTip="Start a new, empty mod (Ctrl+N)"
                            Style="{StaticResource ButtonAccent}"
                            Margin="0,0,8,0"
                            Click="NewButton_Click"/>
                    <Button Content="Load Mod"
                            ToolTip="Open a .dm mod file (Ctrl+O)"
                            Style="{StaticResource ButtonBase}"
                            Click="LoadButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
