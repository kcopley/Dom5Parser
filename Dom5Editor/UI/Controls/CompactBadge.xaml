<UserControl x:Class="Dom5Editor.UI.Controls.CompactBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:Dom5Editor.UI.Behaviors"
             xmlns:local="clr-namespace:Dom5Editor.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="20" d:DesignWidth="100"
             x:Name="Root">
    <!--
        One value on an entity page. A page can have a hundred of these, so each part a badge may
        need (its value box, a reference's name and picker, the link button, the n/r and inh tags,
        the remove button) is a template made only when the badge needs that part.
    -->
    <UserControl.Resources>
        <!-- a part shown when its condition (the ContentControl's Tag binding, true) holds -->
        <Style x:Key="Part" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ": value" and what the value means -->
        <DataTemplate x:Key="ValuePart">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text=": " FontSize="9" VerticalAlignment="Center"
                           Foreground="{Binding LabelForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBox Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                         FontSize="9" MinWidth="24" Padding="3,1"
                         HorizontalContentAlignment="Center" VerticalAlignment="Center"
                         Foreground="{Binding LabelForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         IsReadOnly="{Binding IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         behaviors:DebouncedTextBoxBehavior.IsEnabled="True">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template" Value="{DynamicResource LightTextBoxTemplate}"/>
                            <Setter Property="Background" Value="#1AFFFFFF"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="Background" Value="#44FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="{Binding ValueNote, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="8" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <!-- a reference that can't be changed here: ": name #id" -->
        <DataTemplate x:Key="ReadOnlyReferencePart">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text=": " FontSize="9" VerticalAlignment="Center"
                           Foreground="{Binding LabelForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock Text="{Binding ReferenceDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="9" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{Binding LabelForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock Text="{Binding ReferenceIdDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="8" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- a reference to change: its name, and the picker made when the name is clicked -->
        <DataTemplate x:Key="EditableReferencePart">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text=": " FontSize="9" VerticalAlignment="Center"
                           Foreground="{Binding LabelForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <ContentControl VerticalAlignment="Center" Focusable="False" IsTabStop="False" Loaded="OnReferenceHostLoaded">
                    <Button Click="OnReferenceEditClick" MinWidth="150" MaxWidth="250" Height="20" Padding="5,0"
                            HorizontalContentAlignment="Left" Cursor="Hand"
                            ToolTip="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Format}, ConverterParameter='{}{0}: click to pick another (type a name or ID to search)'}"
                            Background="#1AFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="0,0,0,1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ReferenceIdDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ReferenceDisplay, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="9"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </ContentControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NavigatePart">
            <Button Content="&#x2192;" FontSize="11" FontWeight="Bold" Padding="3,0" Margin="4,0,0,0" MinWidth="20" Height="18"
                    VerticalAlignment="Center" Click="OnNavigateClick"
                    ToolTip="{Binding ReferenceDisplay, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Format}, ConverterParameter='Open {0}'}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentHighlightBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource BackgroundMediumBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="NotReadPart">
            <Border Background="{DynamicResource AccentSecondaryBrush}" CornerRadius="2" Padding="2,0" Margin="3,0,0,0" VerticalAlignment="Center"
                    ToolTip="Dominions doesn't read this command for this entity type: kept in the mod, but it changes nothing in game">
                <TextBlock Text="n/r" Foreground="White" FontSize="7"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InheritedPart">
            <Border Background="{DynamicResource AccentSecondaryBrush}" CornerRadius="2" Padding="2,0" Margin="3,0,0,0" VerticalAlignment="Center"
                    ToolTip="Inherited: the entity has this from vanilla (or from what it copies), not from a line of the mod. Changing it writes the mod's own line.">
                <TextBlock Text="inh" Foreground="White" FontSize="7"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RemovePart">
            <Button Content="&#x00D7;" FontSize="8" Padding="1,0" Margin="3,0,0,0" MinWidth="12" Height="12" VerticalAlignment="Center"
                    ToolTip="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Format}, ConverterParameter='Remove {0} (an inherited one is removed the game\'s way: #x 0 or a clear; Undo brings it back)'}"
                    Command="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{Binding LabelForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{Binding BadgeBackground, ElementName=Root}"
            BorderBrush="{Binding BadgeBorder, ElementName=Root}"
            BorderThickness="1" CornerRadius="3" Padding="5,2" Margin="0,0,4,4"
            ToolTip="{Binding Tooltip, ElementName=Root}">
        <StackPanel Orientation="Horizontal">
            <!-- markers: from this mod (gold bar), set in this session (cyan dot), an icon -->
            <Rectangle Width="2" Fill="{DynamicResource AccentHighlightBrush}" Margin="0,0,3,0" RadiusX="1" RadiusY="1"
                       Visibility="{Binding IsModified, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Ellipse Width="4" Height="4" Fill="{DynamicResource SessionEditBrush}" Margin="0,0,3,0" VerticalAlignment="Center"
                     Visibility="{Binding IsSessionEdit, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Image Width="12" Height="12" Margin="0,0,3,0" VerticalAlignment="Center" Source="{Binding IconSource, ElementName=Root}"
                   Visibility="{Binding HasIcon, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <local:GameIcon Kind="{Binding IconKind, ElementName=Root}" Width="12" Height="12" Margin="0,0,3,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="9" VerticalAlignment="Center"
                       Foreground="{Binding LabelForeground, ElementName=Root}"/>

            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource Part}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasValue, ElementName=Root}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource ValuePart}"/>
                                <Setter Property="Content" Value="{Binding}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource Part}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowReadOnlyReference, ElementName=Root}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource ReadOnlyReferencePart}"/>
                                <Setter Property="Content" Value="{Binding}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsReferenceEditable, ElementName=Root}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource EditableReferencePart}"/>
                                <Setter Property="Content" Value="{Binding}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource Part}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowNavigateButton, ElementName=Root}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource NavigatePart}"/>
                                <Setter Property="Content" Value="{Binding}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource Part}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowNotRead, ElementName=Root}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource NotReadPart}"/>
                                <Setter Property="Content" Value="{Binding}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource Part}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInherited, ElementName=Root}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource InheritedPart}"/>
                                <Setter Property="Content" Value="{Binding}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource Part}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanRemove, ElementName=Root}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource RemovePart}"/>
                                <Setter Property="Content" Value="{Binding}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </StackPanel>
    </Border>
</UserControl>
